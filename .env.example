# Poolée (runtime Next.js / Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Non poolée (migrations `prisma migrate`). Optionnel si fournie par Neon.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Secret de chiffrement Better Auth (32 octets min, base64). Ne jamais committer.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# URL publique de l'app (dev + prod). Utilisée pour trustedOrigins.
BETTER_AUTH_URL="http://localhost:3000"
